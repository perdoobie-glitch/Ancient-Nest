; Ancient Nest — Godot 4.6 playable prototype
config_version=5
[application]
config/name="Ancient Nest"
config/version="10.5-dev"
run/flush_stdout_on_print=true
run/main_scene="res://addons/ancient_nest/login.tscn"
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
boot_splash/bg_color=Color(0.106,0.106,0.11,1)
boot_splash/image="res://assets/intro/loading.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=640
window/size/min_height=360
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=7.34693877
[audio]
driver/enable_input=false

[autoload]
AncientNestAuth="*res://addons/ancient_nest/auth.gd"
AncientNestDiscordVoice="*res://addons/ancient_nest/discord_voice.gd"
AncientNestVerification="*res://addons/ancient_nest/verification_panel.gd"
AncientNestAccountGuard="*res://addons/ancient_nest/integration_guard.gd"

[ancient_nest]
original_main_scene="res://intro/intro_scene.tscn"
account_api="https://ancient-nest-accounts.ancientnest-llc.workers.dev"
