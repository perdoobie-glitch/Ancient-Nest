{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ancient-nest-matchmaking",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "MATCHMAKER", "class_name": "Matchmaker" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker"] }],
  "vars": {
    "ACCOUNT_API": "https://ancientnest.net",
    "ALLOW_GUESTS": "false",
    "VOTE_SECONDS": "25",
  },
  "observability": { "enabled": true },
}
