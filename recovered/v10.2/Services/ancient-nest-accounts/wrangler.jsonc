{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ancient-nest-accounts",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "assets": {
    "directory": "../ancient-nest-web/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": { "SITE_ORIGIN": "https://ancientnest.net", "STEAM_APP_ID": "", "REQUIRE_OWNERSHIP": "false" },
  "d1_databases": [{
    "binding": "ACCOUNTS_DB",
    "database_name": "ancient-nest-accounts",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
