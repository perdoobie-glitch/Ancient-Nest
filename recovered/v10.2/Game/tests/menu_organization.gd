extends SceneTree
var game
var checks=0
var failures=0
func _initialize():call_deferred("run")
func frames(n=3):
 for i in range(n):await process_frame
func check(ok: bool,message: String):
 checks+=1
 if ok:print("PASS: "+message)
 else:failures+=1;push_error("FAIL: "+message)
func search(field: LineEdit,value: String):field.text=value;field.text_changed.emit(value)
func run():
 game=load("res://scenes/main.tscn").instantiate();root.add_child(game)
 var service=game.lobby_network;service.set_process(false);game.lobby_network=null
 game.god_mode=true
 await frames();game.apply_game_type_settings(GameTypeSettings.new());game.show_lobby();await frames()
 var lobby_search=game.screen.find_child("LobbySettingsSearch",true,false)
 check(lobby_search is LineEdit,"Lobby has a search field")
 search(lobby_search,"bots");await frames()
 var entry=game.screen.find_child("EditGameTypeSettings",true,false)
 check(entry.is_visible_in_tree(),"Searching bots keeps full rule editor accessible")
 check(not game.screen.find_child("LobbyLoadLayout",true,false).is_visible_in_tree(),"Lobby search filters unrelated map actions")
 check(game.lobby_roster_box.is_visible_in_tree(),"Lobby roster stays visible during search")
 search(lobby_search,"");check(not game.screen.find_child("LobbyLoadLayout",true,false).is_visible_in_tree(),"Clearing search returns to the selected lobby category")
 var category=game.screen.find_child("LobbyCategory",true,false);category.select(1);category.item_selected.emit(1);await frames()
 check(game.screen.find_child("LobbyLoadLayout",true,false).is_visible_in_tree(),"Map category exposes map actions")
 category.select(0);category.item_selected.emit(0);await frames()
 entry.pressed.emit();await frames();var editor=game.game_type_editor
 editor.jump_to_category("Bots");await frames()
 check(editor.tabs.get_tab_title(editor.tabs.current_tab)=="Bots","Single match settings entry opens navigable categories")
 check(not editor.controls.has("sniper_instant_headshots") and not editor.controls.has("annu_precision_ignores_helmet"),"Obsolete exceptions are not exposed as nonfunctional toggles")
 check(not editor.tabs.tabs_visible and editor.category_list.item_count>=7,"One category list replaces duplicated rule navigation")
 check(editor.tabs.get_tab_title(0)=="Match" and editor.tabs.get_tab_title(1)=="Map" and editor.tabs.get_tab_title(2)=="Bots","Rule categories start with match setup and bots")
 var count=editor.search_rows.size();editor.controls.gravity_percent.value=85
 search(editor.search_box,"gravity");await frames()
 check(editor.controls.gravity_percent.get_parent().is_visible_in_tree(),"Rules search finds gravity across categories")
 check(not editor.controls.bot_difficulty.get_parent().visible,"Rules search hides unrelated bot controls")
 check(editor.category_list.item_count<editor.tabs.get_tab_count(),"Search narrows categories to matching rules")
 search(editor.search_box,"damage");await frames()
 check(editor.category_list.item_count>1,"Search finds damage controls across multiple categories")
 search(editor.search_box,"no_such_rule_xyz");await frames()
 check(not editor.tabs.visible and "No matching" in editor.search_status.text,"Rules show an explicit no-results state")
 check(editor.draft.gravity_percent==85,"Searching never modifies edited rule values")
 editor.dismiss_back();await frames()
 check(editor.search_box.text.is_empty() and editor.tabs.visible and editor.search_rows.size()==count,"Escape clears search first without destroying controls")
 check(editor.controls.gravity_percent.value==85,"Clearing search preserves numeric controls")
 search(editor.search_box,"slayer");await frames()
 check(editor.saved_types.item_count>1,"Rules search also finds game-type templates")
 search(editor.search_box,"");await frames()
 editor.character_selector.select(1);editor.trait_scope=String(editor.character_selector.get_item_metadata(1));editor.sync_draft_controls()
 search(editor.search_box,"bots");await frames()
 check(not editor.controls.bot_difficulty.get_parent().visible,"Search cannot reveal match-wide rules within character traits")
 editor.jump_to_category("Bots");await frames()
 check(editor.trait_scope.is_empty() and editor.tabs.get_tab_title(editor.tabs.current_tab)=="Bots","Category shortcuts restore shared scope when required")
 editor.controls.health_type.select(2);editor.set_draft_value("health_type",2)
 search(editor.search_box,"shield recharge");await frames()
 check(not editor.controls.shield_recharge_delay.get_parent().visible,"Search respects health-type applicability")
 search(editor.search_box,"");editor.editable=false;editor.sync_draft_controls()
 check(not editor.controls.gravity_percent.editable and editor.controls.mode.disabled,"Read-only controls stay disabled after search")
 editor.close_editor();await frames();game.open_settings("lobby");await frames()
 var before=game.draft.duplicate(true);var binding_count=game.draft_keys.size()
 search(game.preferences_search,"resolution");await frames()
 check(game.preferences_groups.Video.is_visible_in_tree() and not game.preferences_groups.Controls.is_visible_in_tree(),"Personal search spans categories without switching tabs")
 check(game.screen.find_child("DisplayResolution",true,false).is_visible_in_tree(),"Resolution control is reachable through global personal search")
 search(game.preferences_search,"nu");await frames()
 check(game.preferences_groups.Controls.is_visible_in_tree(),"Search reaches Nu controls")
 search(game.preferences_search,"radar");await frames()
 check(game.preferences_groups.HUD.is_visible_in_tree(),"Search reaches HUD radar settings")
 search(game.preferences_search,"no_such_preference_xyz");await frames()
 check("No matching" in game.preferences_results.text,"Preferences show an explicit no-results state")
 search(game.preferences_search,"");await frames()
 check(game.draft==before and game.draft_keys.size()==binding_count,"Personal search preserves preference and keyboard drafts")
 check(game.preferences_groups.Controls.is_visible_in_tree() and not game.preferences_groups.Video.is_visible_in_tree(),"Clearing personal search returns to selected category")
 search(game.preferences_search,"jump");await frames()
 var bindings=game.screen.find_children("*","Button",true,false).filter(func(b):return b.get_meta("action","")=="jump")
 check(bindings.size()==1 and bindings[0].is_visible_in_tree(),"Keyboard bindings remain searchable and usable")
 check(NestMenuSearch.matches("armour","Annu armor") and NestMenuSearch.matches("MINIMAP","Radar background"),"Search supports casing and common aliases")
 game.settings_tab="Audio";game.preferences_query="";game.preferences_search.text="";game.filter_preferences()
 var audio_key=String(game.prefs.audio_buses[0].slider.key);game.draft[audio_key]=0.123
 var mouse_before=game.draft.sensitivity
 game.restore_tab();await frames()
 check(game.prefs.audio_buses.all(func(bus):return game.draft[bus.slider.key]==NestPreferences.DEFAULTS.get(bus.slider.key,1.0)),"Audio category reset restores every sound channel")
 check(game.draft.sensitivity==mouse_before,"Audio reset preserves other preference categories")
 game.return_from_settings();await frames()
 check(game.current_screen=="lobby","Lobby personal settings returns to the lobby")
 game.queue_free();await frames(8)
 print("MENU ORGANIZATION: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
