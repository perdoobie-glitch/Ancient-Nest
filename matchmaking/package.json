{
  "name": "ancient-nest-matchmaking",
  "version": "10.5.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/worker.ts src/core.ts src/monitor.ts src/control_policy.ts --bundle --format=esm --platform=browser --target=es2022 --outdir=dist",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run typecheck && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "wrangler": "^4.151.2"
  }
}
